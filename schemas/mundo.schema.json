{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rpg://schemas/mundo/v1",
  "title": "Mundo RPG",
  "type": "object",
  "required": ["id", "nome", "tipo", "versao", "tempo"],
  "properties": {
    "id": {"type": "string", "pattern": "^[0-9]{3}$"},
    "nome": {"type": "string", "minLength": 1},
    "descricao": {"type": "string"},
    "tipo": {"enum": ["real", "fantasia"]},
    "versao": {"type": "integer", "minimum": 1},
    "data_criacao": {"type": "string"},
    "tempo": {"$ref": "tempo.schema.json"},
    "configuracao": {"type": "object"}
  },
  "additionalProperties": true
}
