HOST=0.0.0.0
PORT=5000
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=900
RPG_DATA_DIR=./data
RPG_LOG_LEVEL=INFO
RPG_CONTEXT_MAX_CHARS=120000

# Web / Internet
# Tavily é recomendado para agentes porque oferece busca e extração.
RPG_WEB_PROVIDER=tavily
TAVILY_API_KEY=
# Alternativa/fallback de busca:
BRAVE_SEARCH_API_KEY=
RPG_WEB_TIMEOUT_SECONDS=20
RPG_WEB_MAX_RESULTS=8
RPG_WEB_MAX_CONTENT_CHARS=12000
TAVILY_SEARCH_DEPTH=basic
RPG_WEB_USER_AGENT=KorczakAI/1.0
